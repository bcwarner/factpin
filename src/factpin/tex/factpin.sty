%% factpin.sty -- pin constants computed in analysis code into the manuscript.
%%
%% Companion to the `factpin' Python package, which writes the \declconstgroup,
%% \declconst and \declconsttext declarations this package consumes.
%%
%% Dependencies: siunitx only. siunitx is on the ACM TAPS accepted-package list and is
%% accepted by IEEE and Elsevier, so this package is safe for camera-ready submission.
%% Everything else used here is LaTeX kernel (expl3), which ships with every LaTeX
%% installation including Overleaf's.
%%
%% Usage:
%%   \usepackage{factpin}
%%   \input{results}                 % generated by the Python side
%%   ... AUROC was \const{auroc_a_ci} ...
%%
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesExplPackage{factpin}{2026/08/14}{0.2.0}
  {Pin constants computed in analysis code into the manuscript}

\RequirePackage{siunitx}

%% ===================================================================== messages

% Note on message text: a control word swallows the space that follows it while TeX is
% tokenising this file, so `\token_to_str:N \foo ~bar' loses the space and prints
% `\foobar'. `\c_backslash_str foo~bar' has no such problem.

\msg_new:nnnn { factpin } { unknown-const }
  { Constant~'#1'~is~not~defined. }
  {
    Check~the~spelling,~or~re-run~the~analysis~that~writes~the~generated~.tex~
    file~and~make~sure~the~manuscript~inputs~it.
  }

\msg_new:nnnn { factpin } { unknown-group }
  { Constant~'#1'~belongs~to~undeclared~group~'#2'. }
  {
    Groups~must~be~declared~with~\c_backslash_str declconstgroup~before~a~
    constant~using~them~is~typeset.~The~generated~.tex~file~normally~does~this~
    for~you.
  }

\msg_new:nnnn { factpin } { unknown-format }
  { Group~'#1'~uses~undefined~format~'#2'. }
  {
    Built-in~formats~are~plain,~list,~ci,~range~and~pm.~Define~your~own~with~
    \c_backslash_str defineconstformat .
  }

\msg_new:nnnn { factpin } { bad-arity }
  { Constant~'#1'~has~#2~value(s),~but~format~'#3'~expects~#4. }
  {
    Either~fix~the~call~in~the~analysis~code,~or~give~the~group~a~format~that~
    takes~that~many~values.
  }

\msg_new:nnn { factpin } { redefined }
  { Constant~'#1'~was~declared~more~than~once;~the~last~value~wins. }

% \msg_expandable_error truncates to one error line, so the distinguishing words come
% first: a long constant name would otherwise eat the whole budget and leave a message
% indistinguishable from unknown-const.
\msg_new:nnn { factpin } { text-no-value }
  {
    Text~constant~'#1'~has~no~raw~numeric~value~for~
    \c_backslash_str constvalue .
  }

\msg_new:nnn { factpin } { unused }
  {
    Constant~'#1'~is~declared~but~never~used~with~\c_backslash_str const .~
    It~may~be~stale.
  }

% l3msg str-ifies message arguments rather than expanding them, so anything held in a
% variable has to be passed through a V variant or the macro name is printed verbatim.
\cs_generate_variant:Nn \msg_error:nnnn   { nnVV , nnnV }
\cs_generate_variant:Nn \msg_error:nnnnnn { nnnVVV }

%% ======================================================================= state

% name -> comma-separated raw values
\prop_new:N \g__factpin_value_prop
% name -> raw LaTeX, for constants pinned as text. Kept apart from the numeric store so
% that \constvalue, which splits its payload on commas, cannot silently truncate a name
% like "Logistic regression, L1" -- it reports text-no-value instead.
\prop_new:N \g__factpin_text_prop
% name -> group name (possibly empty)
\prop_new:N \g__factpin_cgroup_prop
% name -> present once the constant has been typeset at least once
\prop_new:N \g__factpin_used_prop
% group -> siunitx options / unit / format name
\prop_new:N \g__factpin_gopts_prop
\prop_new:N \g__factpin_gunit_prop
\prop_new:N \g__factpin_gfmt_prop
% format name -> expected number of values (empty = any)
\prop_new:N \g__factpin_arity_prop

\str_new:N   \l__factpin_key_str
\tl_new:N    \l__factpin_payload_tl
\tl_new:N    \l__factpin_group_tl
\tl_new:N    \l__factpin_fmt_tl
\tl_new:N    \l__factpin_arity_tl
\tl_new:N    \l__factpin_count_tl
\tl_new:N    \l__factpin_tmp_tl
\clist_new:N \l__factpin_parts_clist

% Rendering state, read by \factpinnum and friends.
\tl_new:N \l__factpin_opts_tl
\tl_new:N \l__factpin_unit_tl

\bool_new:N \g__factpin_warn_unused_bool
\bool_new:N \g__factpin_indoc_bool
\tl_new:N   \l__factpin_cilabel_tl

\keys_define:nn { factpin }
  {
    warn-unused .bool_gset:N = \g__factpin_warn_unused_bool ,
    warn-unused .initial:n   = true ,
    ci-label    .tl_set:N    = \l__factpin_cilabel_tl ,
    ci-label    .initial:n   = { 95\%~CI: } ,
  }

\NewDocumentCommand \constsetup { m } { \keys_set:nn { factpin } {#1} }

\AtBeginDocument { \bool_gset_true:N \g__factpin_indoc_bool }

%% ============================================== siunitx front-ends for formats
%%
%% These read the current group's options and unit, so a format template never has to
%% know whether the group carries a unit.

\cs_new_protected:Npn \__factpin_num:nn      #1#2     { \num      [#1] {#2} }
\cs_new_protected:Npn \__factpin_qty:nnn     #1#2#3   { \qty      [#1] {#2} {#3} }
\cs_new_protected:Npn \__factpin_nrange:nnn  #1#2#3   { \numrange [#1] {#2} {#3} }
\cs_new_protected:Npn \__factpin_qrange:nnnn #1#2#3#4 { \qtyrange [#1] {#2} {#3} {#4} }
\cs_new_protected:Npn \__factpin_nlist:nn    #1#2     { \numlist  [#1] {#2} }
\cs_new_protected:Npn \__factpin_qlist:nnn   #1#2#3   { \qtylist  [#1] {#2} {#3} }

\cs_generate_variant:Nn \__factpin_num:nn      { Vn }
\cs_generate_variant:Nn \__factpin_qty:nnn     { VnV }
\cs_generate_variant:Nn \__factpin_nrange:nnn  { Vnn }
\cs_generate_variant:Nn \__factpin_qrange:nnnn { VnnV }
\cs_generate_variant:Nn \__factpin_nlist:nn    { VV }
\cs_generate_variant:Nn \__factpin_qlist:nnn   { VVV }

% \factpinnum {value}
\cs_new_protected:Npn \factpinnum #1
  {
    \tl_if_empty:NTF \l__factpin_unit_tl
      { \__factpin_num:Vn \l__factpin_opts_tl {#1} }
      { \__factpin_qty:VnV \l__factpin_opts_tl {#1} \l__factpin_unit_tl }
  }

% \factpinrange {lower} {upper}
\cs_new_protected:Npn \factpinrange #1#2
  {
    \tl_if_empty:NTF \l__factpin_unit_tl
      { \__factpin_nrange:Vnn \l__factpin_opts_tl {#1} {#2} }
      { \__factpin_qrange:VnnV \l__factpin_opts_tl {#1} {#2} \l__factpin_unit_tl }
  }

% \factpinlist -- every value of the current constant. siunitx separates list items
% with semicolons, so the comma-separated payload is converted here.
\cs_new_protected:Npn \factpinlist
  {
    \tl_set:Nx \l__factpin_tmp_tl { \clist_use:Nn \l__factpin_parts_clist { ; } }
    \tl_if_empty:NTF \l__factpin_unit_tl
      { \__factpin_nlist:VV \l__factpin_opts_tl \l__factpin_tmp_tl }
      { \__factpin_qlist:VVV \l__factpin_opts_tl \l__factpin_tmp_tl \l__factpin_unit_tl }
  }

% One value -> a number; several -> a list. Used by the `plain' format so that a
% group-less constant always renders sensibly.
\cs_new_protected:Npn \factpinauto
  {
    \int_compare:nNnTF { \clist_count:N \l__factpin_parts_clist } = { 1 }
      { \exp_args:Nx \factpinnum { \clist_item:Nn \l__factpin_parts_clist { 1 } } }
      { \factpinlist }
  }

%% ===================================================================== formats

% \defineconstformat [<arity>] {<name>} {<code using #1 #2 #3>}
% An empty arity means the format accepts any number of values.
\NewDocumentCommand \defineconstformat { O{} m m }
  {
    \cs_set_protected:cpn { __factpin_format_ \tl_to_str:n {#2} :nnn } ##1##2##3 {#3}
    \prop_gput:Nnn \g__factpin_arity_prop {#2} {#1}
  }

\defineconstformat    {plain} { \factpinauto }
\defineconstformat    {list}  { \factpinlist }
% \c_space_tl rather than ~ after the label: a control word swallows a following space.
\defineconstformat[3] {ci}    { \factpinnum {#1} ~ ( \l__factpin_cilabel_tl \c_space_tl \factpinrange {#2} {#3} ) }
\defineconstformat[2] {range} { \factpinrange {#1} {#2} }
\defineconstformat[2] {pm}    { \factpinnum {#1} ~ \ensuremath { \pm } ~ \factpinnum {#2} }

%% ================================================================ declarations

% \declconstgroup {<name>} {<siunitx options>} {<unit>} {<format>}
% Re-declaring a group overrides it, so a manuscript can adjust the presentation after
% \input-ing the generated file without editing generated output.
\NewDocumentCommand \declconstgroup { m m m m }
  {
    \prop_gput:Nnn \g__factpin_gopts_prop {#1} {#2}
    \prop_gput:Nnn \g__factpin_gunit_prop {#1} {#3}
    \prop_gput:Nnn \g__factpin_gfmt_prop  {#1} {#4}
  }

% A name lives in exactly one of the two stores, so this warns at most once.
\cs_new_protected:Npn \__factpin_warn_redefined:n #1
  {
    \prop_if_in:NVT \g__factpin_value_prop \l__factpin_key_str
      { \msg_warning:nnn { factpin } { redefined } {#1} }
    \prop_if_in:NVT \g__factpin_text_prop \l__factpin_key_str
      { \msg_warning:nnn { factpin } { redefined } {#1} }
  }

% \declconst {<name>} {<comma-separated values>} {<group, possibly empty>}
\NewDocumentCommand \declconst { m m m }
  {
    \str_set:Nn \l__factpin_key_str {#1}
    \__factpin_warn_redefined:n {#1}
    \prop_gput:NVn \g__factpin_value_prop  \l__factpin_key_str {#2}
    \prop_gput:NVn \g__factpin_cgroup_prop \l__factpin_key_str {#3}
  }

% \declconsttext {<name>} {<raw LaTeX>}
% No group: units and rounding are meaningless for a model or cohort name. The payload
% is typeset verbatim, so markup in it survives.
\NewDocumentCommand \declconsttext { m m }
  {
    \str_set:Nn \l__factpin_key_str {#1}
    \__factpin_warn_redefined:n {#1}
    \prop_gput:NVn \g__factpin_text_prop \l__factpin_key_str {#2}
  }

%% ========================================================================= use

\NewDocumentCommand \const { m } { \__factpin_use:n {#1} }

\cs_new_protected:Npn \__factpin_use:n #1
  {
    \str_set:Nn \l__factpin_key_str {#1}
    \prop_get:NVNTF \g__factpin_text_prop \l__factpin_key_str \l__factpin_payload_tl
      { \tl_use:N \l__factpin_payload_tl \__factpin_mark_used:n {#1} }
      {
        \prop_get:NVNTF \g__factpin_value_prop \l__factpin_key_str
          \l__factpin_payload_tl
          { \__factpin_render:n {#1} \__factpin_mark_used:n {#1} }
          { \msg_error:nnn { factpin } { unknown-const } {#1} \textbf { ?? } }
      }
  }

% The label is emitted at the point of *use*, not declaration: that is what ties a
% number in the manuscript to a location, and makes \ref{const:<name>} /
% \pageref{const:<name>} point at where the reader actually meets the value. Only the
% first use is labelled, so a constant quoted twice does not trigger a duplicate label.
\cs_new_protected:Npn \__factpin_mark_used:n #1
  {
    \prop_if_in:NVF \g__factpin_used_prop \l__factpin_key_str
      {
        \prop_gput:NVn \g__factpin_used_prop \l__factpin_key_str {}
        \bool_if:NT \g__factpin_indoc_bool { \label { const: #1 } }
      }
  }

\cs_new_protected:Npn \__factpin_render:n #1
  {
    \clist_set:NV \l__factpin_parts_clist \l__factpin_payload_tl
    \tl_clear:N \l__factpin_opts_tl
    \tl_clear:N \l__factpin_unit_tl
    \tl_set:Nn \l__factpin_fmt_tl { plain }

    \prop_get:NVNF \g__factpin_cgroup_prop \l__factpin_key_str \l__factpin_group_tl
      { \tl_clear:N \l__factpin_group_tl }

    \tl_if_empty:NF \l__factpin_group_tl
      {
        \prop_get:NVNTF \g__factpin_gfmt_prop \l__factpin_group_tl \l__factpin_fmt_tl
          {
            \prop_get:NVNF \g__factpin_gopts_prop \l__factpin_group_tl
              \l__factpin_opts_tl { \tl_clear:N \l__factpin_opts_tl }
            \prop_get:NVNF \g__factpin_gunit_prop \l__factpin_group_tl
              \l__factpin_unit_tl { \tl_clear:N \l__factpin_unit_tl }
          }
          {
            \msg_error:nnnV { factpin } { unknown-group } {#1} \l__factpin_group_tl
            \tl_set:Nn \l__factpin_fmt_tl { plain }
          }
      }

    % A single value always renders plain, whatever the group's format says, so one
    % group can hold both a point estimate and the interval that belongs with it.
    \int_compare:nNnT { \clist_count:N \l__factpin_parts_clist } = { 1 }
      { \tl_set:Nn \l__factpin_fmt_tl { plain } }

    \cs_if_exist:cTF { __factpin_format_ \l__factpin_fmt_tl :nnn }
      { \__factpin_check_arity:n {#1} \__factpin_apply_format: }
      {
        \msg_error:nnVV { factpin } { unknown-format }
          \l__factpin_group_tl \l__factpin_fmt_tl
        \factpinauto
      }
  }

\cs_new_protected:Npn \__factpin_check_arity:n #1
  {
    \prop_get:NVNT \g__factpin_arity_prop \l__factpin_fmt_tl \l__factpin_arity_tl
      {
        \tl_if_empty:NF \l__factpin_arity_tl
          {
            \tl_set:Nx \l__factpin_count_tl
              { \clist_count:N \l__factpin_parts_clist }
            \int_compare:nNnF
                { \l__factpin_count_tl } = { \l__factpin_arity_tl }
              {
                \msg_error:nnnVVV { factpin } { bad-arity } {#1}
                  \l__factpin_count_tl \l__factpin_fmt_tl \l__factpin_arity_tl
              }
          }
      }
  }

% Hand the first three values to the format template as #1, #2, #3. Missing values come
% through empty; formats that need every value use \factpinlist instead.
\cs_new_protected:Npn \__factpin_apply_format:
  {
    \use:x
      {
        \exp_not:c { __factpin_format_ \l__factpin_fmt_tl :nnn }
          { \clist_item:Nn \l__factpin_parts_clist { 1 } }
          { \clist_item:Nn \l__factpin_parts_clist { 2 } }
          { \clist_item:Nn \l__factpin_parts_clist { 3 } }
      }
  }

%% ================================================================== raw access

% \constvalue [<index>] {<name>} -- the raw, unformatted value. Expandable, so it can be
% used where a bare number is required (pgfplots coordinates, \ifnum, calc, ...).
\NewExpandableDocumentCommand \constvalue { O{1} m }
  { \__factpin_value:nn {#2} {#1} }

\cs_new:Npn \__factpin_value:nn #1#2
  { \exp_args:Ne \__factpin_value_aux:nnn { \tl_to_str:n {#1} } {#1} {#2} }

% Text is looked up first, mirroring \const, so a text constant gets its own message
% rather than the misleading "is not defined". Each lookup is a separate \exp_args:Ne
% so that only long-standing expl3 variants are needed; the chain stays expandable.
\cs_new:Npn \__factpin_value_aux:nnn #1#2#3
  {
    \exp_args:Ne \__factpin_value_text:nnnn
      { \prop_item:Nn \g__factpin_text_prop {#1} } {#1} {#2} {#3}
  }

\cs_new:Npn \__factpin_value_text:nnnn #1#2#3#4
  {
    \tl_if_empty:nTF {#1}
      {
        \exp_args:Ne \__factpin_value_use:nnn
          { \prop_item:Nn \g__factpin_value_prop {#2} } {#3} {#4}
      }
      { \msg_expandable_error:nnn { factpin } { text-no-value } {#3} ?? }
  }

\cs_new:Npn \__factpin_value_use:nnn #1#2#3
  {
    \tl_if_empty:nTF {#1}
      { \msg_expandable_error:nnn { factpin } { unknown-const } {#2} ?? }
      { \clist_item:nn {#1} {#3} }
  }

%% ============================================== declared-but-never-used warning

\cs_new_protected:Npn \__factpin_check_unused:
  {
    \prop_map_inline:Nn \g__factpin_value_prop
      {
        \prop_if_in:NnF \g__factpin_used_prop {##1}
          { \msg_warning:nnn { factpin } { unused } {##1} }
      }
    \prop_map_inline:Nn \g__factpin_text_prop
      {
        \prop_if_in:NnF \g__factpin_used_prop {##1}
          { \msg_warning:nnn { factpin } { unused } {##1} }
      }
  }

\AtEndDocument
  { \bool_if:NT \g__factpin_warn_unused_bool { \__factpin_check_unused: } }
